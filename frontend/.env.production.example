# Production Environment
REACT_APP_ENV=production
REACT_APP_API_URL=https://api.cloudops.io/api
REACT_APP_SOCKET_URL=https://api.cloudops.io
REACT_APP_DEBUG=false
REACT_APP_LOG_LEVEL=error

# GitHub OAuth (Production)
REACT_APP_GITHUB_CLIENT_ID=your_prod_github_client_id

# Feature Flags
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_ENABLE_COST_PREDICTION=true
